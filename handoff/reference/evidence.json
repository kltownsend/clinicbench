 "human_decisions": [
  {
   "id": "ruling.clinic-reference-bindings",
   "decided_by": "Keith Townsend",
   "decided_at": "2026-10-25T02:04:02Z",
   "decision": "Role-to-function bindings for clinic.reference.f: fr.write-check unmapped at layer2b; fr.records to layer1a relational-htap; fr.consent-judge stays layer2c policy-reasoning; fr.workflow unmapped at layer3, fr.reader-model layer2b models, fr.reader-engine layer2b inference-engine and fr.compute layer0a deskside as drafted; the five authority bindings and the layer accounting approved as drafted.",
   "reason": "tool-execution is defined as vendor-side and the reference's tools are the bench's own code; the records requirement is a transactional system of record; policy-reasoning describes the 2C decision Lab 029 placed there and grants the driver's host no grade.",
   "refs": [
    "handoff/reference/architecture.json",
    "https://labs.layer2c.com/labs/who-decides-consent"
   ]
  },
  {
   "id": "ruling.clinic-reference-typed-links",
   "decided_by": "Keith Townsend",
   "decided_at": "2026-10-25T03:15:23Z",
   "decision": "Typed links (handoff v1.1) for clinic.reference.f, as proposed: binding.workflow rests on fr.workflow; binding.consent and binding.selfpay-willing on fr.consent-judge; binding.write-check on fr.write-check and fr.records; binding.selfpay-claim-ceiling carries no list because nothing enforces it.",
   "reason": "Each binding should rest on the functions that make its decision, not on every function its implementer happens to implement. Under F the reader's yes never commits consent, so the reader stays out of the consent list and is reached through the consent judge's dependency on it.",
   "refs": [
    "handoff/reference/architecture.json",
    "layer2csite schemas/handoff/v1 at 72c15bc"
   ]
  }
 ]
