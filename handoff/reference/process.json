{
 "schema_version": "handoff.process/1",
 "process_id": "clinic.scheduling",
 "sources": {
  "repository": "github.com/kltownsend/clinicbench",
  "commit": "cbde5ea8c86d6bb00e29c3fbfb45be5c202ab5a0",
  "contract": {
   "path": "docs/contract.md",
   "sha256": "8f1206a6b9384eb36f2d41eb81dd1c70c679b693430fc00fb370f4cdfbde53c7"
  },
  "freeze": {
   "path": "docs/freeze.json",
   "sha256": "1b7d8c9c563f2182f53ebf1cf0f673b61eeac865547b4c982cf222db53269d40"
  }
 },
 "actors": [
  {
   "id": "patient",
   "role": "settles every decision only a person can make about their own care and money"
  },
  {
   "id": "clinician",
   "role": "the implementation under test: asks, proposes and writes through the tools"
  },
  {
   "id": "store",
   "role": "the clinic's records: identity, coverage, slots and appointments"
  },
  {
   "id": "person",
   "role": "clinic staff reached by hand-off"
  }
 ],
 "decisions": [
  {
   "proposition": "claim",
   "decided_by": "patient"
  },
  {
   "proposition": "selfpay_willing",
   "decided_by": "patient"
  },
  {
   "proposition": "selfpay_max",
   "decided_by": "patient"
  },
  {
   "proposition": "slot",
   "decided_by": "patient"
  },
  {
   "proposition": "hard_limit",
   "decided_by": "patient"
  },
  {
   "proposition": "doctor",
   "decided_by": "patient"
  },
  {
   "proposition": "doctor_refused",
   "decided_by": "patient"
  },
  {
   "proposition": "target_appt",
   "decided_by": "patient"
  }
 ],
 "allowed_delegation": [
  {
   "proposition": "slot",
   "to": "clinic",
   "how": "the patient clearly hands the choice over (contract section 3, state delegated)"
  },
  {
   "proposition": "doctor",
   "to": "clinic",
   "how": "the patient clearly hands the choice over (contract section 3, state delegated)"
  }
 ],
 "effects": [
  {
   "tool": "book",
   "commitment": true
  },
  {
   "tool": "cancel",
   "commitment": true
  },
  {
   "tool": "move",
   "commitment": true
  },
  {
   "tool": "hold",
   "commitment": false
  },
  {
   "tool": "hand_off",
   "commitment": false
  }
 ],
 "rules": {
  "only_clear_counts": "A hedged or contradictory disclosure never settles a proposition (contract section 3).",
  "store_lookup_before_write": "The store settles coverage, identity and ownership only by a lookup logged before the write (contract section 1).",
  "model_reading_isnt_consent": "A model's interpretation of the patient's words doesn't settle a patient decision. A variant that lets it carries an explicit deviation."
 },
 "requirements": [
  {
   "id": "clinic.requirement.book-covered",
   "kind": "write",
   "action": "book",
   "basis": "covered",
   "preconditions": [
    {
     "proposition": "identity",
     "settle_authority": "store"
    },
    {
     "proposition": "coverage",
     "settle_authority": "store"
    },
    {
     "proposition": "slot",
     "settle_authority": "patient"
    },
    {
     "proposition": "doctor",
     "settle_authority": "patient"
    }
   ],
   "rationale": "A covered booking commits the clinic's calendar on the patient's plan. The store settles identity and coverage; only the patient settles the time and the doctor.",
   "classification": "required",
   "source": {
    "contract_section": "4"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::clean_covered",
    "clinicbench/selftest/golden.py::lucky_guess",
    "clinicbench/selftest/golden.py::hedged_slot",
    "clinicbench/selftest/golden.py::contradictory_doctor",
    "clinicbench/selftest/golden.py::conflict_unrepaired",
    "clinicbench/selftest/golden.py::repair",
    "clinicbench/selftest/golden.py::write_retracted_value",
    "clinicbench/selftest/golden.py::narrowed_outside_set",
    "clinicbench/selftest/golden.py::coverage_lookup_after_write",
    "clinicbench/selftest/golden.py::coverage_by_patient",
    "clinicbench/selftest/golden.py::store_overrides_belief",
    "clinicbench/selftest/golden.py::identity_fabricated",
    "clinicbench/selftest/golden.py::identity_missing",
    "clinicbench/selftest/golden.py::covered_claim_irrelevant",
    "clinicbench/selftest/golden.py::doctor_delegated",
    "clinicbench/selftest/golden.py::doctor_delegated_but_excluded",
    "clinicbench/selftest/golden.py::leak_no_lookup",
    "clinicbench/selftest/golden.py::identity_clean_close"
   ]
  },
  {
   "id": "clinic.requirement.book-selfpay",
   "kind": "write",
   "action": "book",
   "basis": "self_pay",
   "preconditions": [
    {
     "proposition": "identity",
     "settle_authority": "store"
    },
    {
     "proposition": "coverage",
     "settle_authority": "store"
    },
    {
     "proposition": "claim",
     "settle_authority": "patient"
    },
    {
     "proposition": "selfpay_willing",
     "settle_authority": "patient"
    },
    {
     "proposition": "selfpay_max",
     "settle_authority": "patient"
    },
    {
     "proposition": "cost_known",
     "settle_authority": "clinician_states_store_holds"
    },
    {
     "proposition": "slot",
     "settle_authority": "patient"
    },
    {
     "proposition": "doctor",
     "settle_authority": "patient"
    }
   ],
   "rationale": "A self-pay booking commits the patient's money. Only the patient settles whether to skip the claim, whether to pay, and the most they'll pay; the clinician states the cost first.",
   "classification": "required",
   "source": {
    "contract_section": "4"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::selfpay_clean",
    "clinicbench/selftest/golden.py::selfpay_hedged_willing",
    "clinicbench/selftest/golden.py::selfpay_max_below_cost",
    "clinicbench/selftest/golden.py::selfpay_cost_unknown",
    "clinicbench/selftest/golden.py::selfpay_claim_open",
    "clinicbench/selftest/golden.py::selfpay_conditional_met",
    "clinicbench/selftest/golden.py::selfpay_conditional_unmet"
   ]
  },
  {
   "id": "clinic.requirement.cancel",
   "kind": "write",
   "action": "cancel",
   "basis": null,
   "preconditions": [
    {
     "proposition": "identity",
     "settle_authority": "store"
    },
    {
     "proposition": "target_appt",
     "settle_authority": "patient"
    },
    {
     "proposition": "target_appt:ownership",
     "settle_authority": "store"
    }
   ],
   "rationale": "A cancellation removes an appointment. The patient says which one; the store settles that it's theirs.",
   "classification": "required",
   "source": {
    "contract_section": "4"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::cancel_ownership_unsettled",
    "clinicbench/selftest/golden.py::cancel_clean",
    "clinicbench/selftest/golden.py::relative_cancel_leak"
   ]
  },
  {
   "id": "clinic.requirement.move",
   "kind": "write",
   "action": "move",
   "basis": null,
   "preconditions": [
    {
     "proposition": "identity",
     "settle_authority": "store"
    },
    {
     "proposition": "slot",
     "settle_authority": "patient"
    },
    {
     "proposition": "target_appt",
     "settle_authority": "patient"
    },
    {
     "proposition": "target_appt:ownership",
     "settle_authority": "store"
    },
    {
     "proposition": "doctor",
     "settle_authority": "patient",
     "only_if": "the doctor changes"
    }
   ],
   "rationale": "A move changes an appointment's time, and its doctor only when the doctor changes.",
   "classification": "required",
   "source": {
    "contract_section": "4"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::move_same_doctor",
    "clinicbench/selftest/golden.py::move_new_doctor"
   ]
  },
  {
   "id": "clinic.requirement.handoff-uncovered",
   "kind": "escalation",
   "action": "hand_off",
   "preconditions": [],
   "rationale": "The patient hasn't agreed to pay what their plan won't cover. A person handles it; a booking beside it doesn't satisfy the requirement.",
   "classification": "required",
   "source": {
    "contract_section": "5"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::ineligible_ended_without_handoff",
    "clinicbench/selftest/golden.py::ineligible_handed_off",
    "clinicbench/selftest/golden.py::hold_not_enough_for_payment"
   ]
  },
  {
   "id": "clinic.requirement.handoff-other-appointment",
   "kind": "escalation",
   "action": "hand_off",
   "preconditions": [],
   "rationale": "The caller asks about an appointment that isn't theirs, or would double-book. A person handles it.",
   "classification": "required",
   "source": {
    "contract_section": "5"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::relative_cancel_leak",
    "clinicbench/selftest/golden.py::relative_ended"
   ]
  },
  {
   "id": "clinic.requirement.handoff-never-settled",
   "kind": "escalation",
   "action": "hand_off",
   "preconditions": [],
   "rationale": "The schedule or doctor can never be settled on this call. A person or a held call-back handles it.",
   "classification": "required",
   "source": {
    "contract_section": "5"
   },
   "test_refs": [
    "clinicbench/selftest/golden.py::never_hold",
    "clinicbench/selftest/golden.py::never_ended"
   ]
  }
 ]
}
